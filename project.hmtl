<div id="app" style="max-width:480px;margin:0 auto;font-family:var(--font-sans, sans-serif);padding:1rem 0;">
  <h1 style="font-size:22px;font-weight:500;margin:0 0 4px;color:var(--text-primary,#222);">Malayalam reader</h1>
  <p style="font-size:14px;color:var(--text-secondary,#666);margin:0 0 20px;line-height:1.5;">
    Point the camera at a line of text. It keeps scanning and reads new lines aloud automatically.
  </p>

  <div id="videoWrap" style="display:none;border-radius:12px;overflow:hidden;border:1px solid var(--border,#ddd);margin-bottom:14px;">
    <video id="video" autoplay muted playsinline style="width:100%;display:block;"></video>
  </div>
  <canvas id="canvas" style="display:none;"></canvas>

  <button id="startBtn" style="
    width:100%;
    padding:20px;
    font-size:18px;
    font-weight:500;
    border-radius:12px;
    border:none;
    background:#1D9E75;
    color:#fff;
    cursor:pointer;
  ">Start scanning</button>

  <button id="stopBtn" style="
    width:100%;
    padding:20px;
    font-size:18px;
    font-weight:500;
    border-radius:12px;
    border:none;
    background:#993C1D;
    color:#fff;
    cursor:pointer;
    display:none;
  ">Stop scanning</button>

  <div id="status" style="margin-top:14px;font-size:14px;color:var(--text-secondary,#666);min-height:20px;"></div>

  <div id="textWrap" style="display:none;margin-top:14px;padding:14px;background:var(--surface-1,#F5F5F0);border-radius:12px;">
    <div style="font-size:12px;color:var(--text-muted,#888);margin-bottom:6px;">Last line read</div>
    <div id="recognizedText" style="font-size:18px;line-height:1.8;color:var(--text-primary,#222);"></div>
  </div>
</div>

<script>
const video = document.getElementById('video');
const videoWrap = document.getElementById('videoWrap');
const canvas = document.getElementById('canvas');
const startBtn = document.getElementById('startBtn');
const stopBtn = document.getElementById('stopBtn');
const statusEl = document.getElementById('status');
const textWrap = document.getElementById('textWrap');
const recognizedText = document.getElementById('recognizedText');

let stream = null;
let scanning = false;
let processing = false;
let lastSpokenText = '';
let malayalamVoice = null;

function loadVoices() {
  const voices = speechSynthesis.getVoices();
  malayalamVoice = voices.find(v => v.lang && v.lang.toLowerCase().startsWith('ml')) || null;
}
loadVoices();
if ('speechSynthesis' in window) {
  speechSynthesis.onvoiceschanged = loadVoices;
}

startBtn.addEventListener('click', startScanning);
stopBtn.addEventListener('click', stopScanning);

async function startScanning() {
  try {
    stream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'environment' }
    });
  } catch (err) {
    statusEl.textContent = 'Could not access the camera. Check camera permission for this page.';
    console.error(err);
    return;
  }

  video.srcObject = stream;
  videoWrap.style.display = 'block';
  startBtn.style.display = 'none';
  stopBtn.style.display = 'block';
  scanning = true;
  lastSpokenText = '';
  statusEl.textContent = 'Scanning...';

  video.onloadedmetadata = () => {
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    scanStep();
  };
}

function stopScanning() {
  scanning = false;
  if (stream) {
    stream.getTracks().forEach(t => t.stop());
    stream = null;
  }
  speechSynthesis.cancel();
  videoWrap.style.display = 'none';
  startBtn.style.display = 'block';
  stopBtn.style.display = 'none';
  statusEl.textContent = '';
}

async function scanStep() {
  if (!scanning || processing) return;
  processing = true;

  const ctx = canvas.getContext('2d');
  ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
  const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
  const base64 = dataUrl.split(',')[1];

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 1000,
        messages: [
          {
            role: 'user',
            content: [
              {
                type: 'image',
                source: { type: 'base64', media_type: 'image/jpeg', data: base64 }
              },
              {
                type: 'text',
                text: 'This image shows printed Malayalam text. Transcribe exactly the Malayalam text visible, in Malayalam script. Output ONLY the transcribed text, nothing else. If no legible Malayalam text is visible, output exactly: NO_TEXT_FOUND'
              }
            ]
          }
        ]
      })
    });

    const data = await response.json();
    const textBlock = (data.content || []).find(b => b.type === 'text');
    const text = textBlock ? textBlock.text.trim() : '';

    if (!scanning) { processing = false; return; }

    if (!text || text === 'NO_TEXT_FOUND') {
      statusEl.textContent = 'Scanning... point at a line of text';
      processing = false;
      setTimeout(scanStep, 1200);
      return;
    }

    if (text === lastSpokenText) {
      statusEl.textContent = 'Scanning...';
      processing = false;
      setTimeout(scanStep, 1000);
      return;
    }

    lastSpokenText = text;
    recognizedText.textContent = text;
    textWrap.style.display = 'block';
    statusEl.textContent = 'Reading...';

    speak(text, () => {
      processing = false;
      if (scanning) {
        statusEl.textContent = 'Scanning...';
        scanStep();
      }
    });

  } catch (err) {
    console.error(err);
    statusEl.textContent = 'Trouble reading that frame, retrying...';
    processing = false;
    setTimeout(scanStep, 1500);
  }
}

function speak(text, onDone) {
  if (!('speechSynthesis' in window)) {
    statusEl.textContent = 'This browser cannot speak text aloud.';
    onDone();
    return;
  }
  speechSynthesis.cancel();
  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = 'ml-IN';
  if (malayalamVoice) {
    utterance.voice = malayalamVoice;
  }
  utterance.onend = onDone;
  utterance.onerror = onDone;
  speechSynthesis.speak(utterance);
}
</script>
